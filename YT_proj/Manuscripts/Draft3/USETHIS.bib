  author = {Cheng, Lijing and Abraham, John and Trenberth, Kevin E. and Boyer, Tim and Mann, Michael E. and Zhu, Jiang and Wang, Fan and Yu, Fujiang and Locarnini, Ricardo and Fasullo, John and Zheng, Fei and Li, Yuanlong and Zhang, Bin and Wan, Liying and Chen, Xingrong and Wang, Dakui and Feng, Licheng and Song, Xiangzhou and Liu, Yulong and Reseghetti, Franco and Simoncelli, Simona and Gouretski, Viktor and Chen, Gengxin and Mishonov, Alexey and Reagan, Jim and Von Schuckmann, Karina and Pan, Yuying and Tan, Zhetao and Zhu, Yujing and Wei, Wangxu and Li, Guancheng and Ren, Qiuping and Cao, Lijuan and Lu, Yayang},
