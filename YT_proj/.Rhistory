ecov_me <- list(
label = "bt_temp",
mean = as.matrix(c(env.dat_me$bt_temp,rep(mean(env.dat_me$bt_temp),31))),
# logsigma = as.matrix(rep(log(0.4733709), 50)),
logsigma = "est_1",
