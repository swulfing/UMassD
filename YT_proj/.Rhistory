assess_interval = assess.interval,
base_years = base.years,
year.use = 50,
add.years = TRUE,
seed = 123+i,
hcr = hcr,
save.sdrep = FALSE,
save.last.em = TRUE,
FXSPR_init = 0.5
)
saveRDS(mod, file.path(sprintf("C:/Users/swulfing/OneDrive - University of Massachusetts Dartmouth/Desktop/MSE_results/Mod.30yr_1_%03d.RDS", i)))
}, error=function(e){})
}
