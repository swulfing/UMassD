catch_advice <- list()
catch_realized <- list()
em_full <- list()
em_input_list <- list()
if(is.null(age_comp_em)) age_comp_em = "multinomial"
if(is.null(em_info)) stop("em_info must be specified!")
em.opt$separate.em
